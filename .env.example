# Copy to .env and fill in. Never commit .env.

# Supabase Postgres. DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true),
# DIRECT_URL = direct connection (port 5432), used only by migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Two different random secrets, at least 32 characters each (openssl rand -base64 48).
STAFF_JWT_SECRET=""
CUSTOMER_JWT_SECRET=""

# Used once by `npm run db:seed` to create the first superadmin.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""
