# Chép thành .env rồi điền. Không bao giờ commit .env.
# Giá trị đang bật bên dưới là cho máy local (Docker, xem README).
# Khi deploy: bỏ comment khối "PRODUCTION" của từng phần và điền giá trị thật vào biến môi trường của Vercel.

# ============================================================================
# 1. DATABASE (Postgres)
# ============================================================================
# Local: Postgres chạy bằng Docker (lệnh trong README), không cần mật khẩu.
DATABASE_URL="postgresql://le@127.0.0.1:54329/learnenglish"
DIRECT_URL="postgresql://le@127.0.0.1:54329/learnenglish"

# PRODUCTION - Supabase. Lấy ở Dashboard > Project Settings > Database > Connection string.
#   DATABASE_URL = "Transaction pooler" (cổng 6543), thêm ?pgbouncer=true ở cuối. App dùng chuỗi này.
#   DIRECT_URL   = "Direct connection" hoặc "Session pooler" (cổng 5432). Chỉ dùng khi chạy migrate.
#   Mật khẩu có ký tự đặc biệt (@ : / # ?) thì phải URL-encode.
# DATABASE_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ============================================================================
# 2. ĐĂNG NHẬP (JWT)
# ============================================================================
# Hai secret KHÁC NHAU, mỗi cái ít nhất 32 ký tự. Tạo bằng: openssl rand -base64 48
# Production dùng secret riêng, không dùng lại secret local. Đổi secret = mọi người bị đăng xuất.
STAFF_JWT_SECRET=""
CUSTOMER_JWT_SECRET=""

# ============================================================================
# 3. LƯU FILE (thu âm bài nói; sau này PDF, audio bài nghe) - qua S3 API
# ============================================================================
# Code chỉ đọc 5 biến S3_*; đổi nơi lưu (MinIO / Supabase / S3 / R2) = đổi 5 biến này, không sửa code.
# Trình duyệt upload thẳng lên bucket bằng URL ký sẵn 5 phút; bucket phải để PRIVATE.

# Local: MinIO bằng Docker (lệnh trong README). MINIO_ROOT_USER / MINIO_ROOT_PASSWORD của container
# phải trùng 2 key dưới (password tối thiểu 8 ký tự). Tạo bucket 1 lần:
#   npx tsx --env-file=.env scripts/create-storage-bucket.ts
S3_ENDPOINT="http://127.0.0.1:54330"
S3_REGION="auto"
S3_ACCESS_KEY_ID="learnenglish"
S3_SECRET_ACCESS_KEY="learnenglish-local-secret"
S3_BUCKET="learnenglish"

# PRODUCTION (dùng tạm) - Supabase Storage qua S3 protocol. Gói free có 1 GB.
#   B1. Dashboard > Storage > New bucket: tên "learnenglish", TẮT Public bucket,
#       Restrict file size: 15 MB, Allowed MIME types: audio/webm, audio/ogg, audio/mp4
#   B2. Dashboard > Storage > S3 Configuration (Settings): bật "S3 protocol connection".
#       Endpoint và Region ghi sẵn trên trang này -> chép vào S3_ENDPOINT, S3_REGION.
#   B3. Cùng trang, mục "S3 Access Keys" > New access key -> chép Access key ID và Secret access key.
#       Secret chỉ hiện 1 lần. Key này có toàn quyền mọi bucket: chỉ để trên server (Vercel env).
#   CORS: Supabase không cho cấu hình CORS qua S3 API; thường không cần, nhưng CHƯA thử thật -
#   nếu trình duyệt báo lỗi CORS khi upload thu âm thì kiểm tra lại chỗ này đầu tiên.
# S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
# S3_REGION="<region của project, vd ap-southeast-1>"
# S3_ACCESS_KEY_ID="<access key id>"
# S3_SECRET_ACCESS_KEY="<secret access key>"
# S3_BUCKET="learnenglish"

# SAU NÀY khi data lớn - Cloudflare R2 (không tính phí tải xuống).
#   R2 > Create bucket; R2 > Manage API tokens > quyền "Object Read & Write" cho bucket đó.
#   Bucket > Settings > CORS policy: cho phép GET, PUT, header Content-Type, origin = domain web.
#   Chép file cũ từ Supabase sang (vd rclone) TRƯỚC khi đổi biến, vì key trong DB giữ nguyên.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="<access key id>"
# S3_SECRET_ACCESS_KEY="<secret access key>"
# S3_BUCKET="learnenglish"

# SAU NÀY - AWS S3. IAM user chỉ có quyền s3:GetObject, s3:PutObject, s3:DeleteObject trên bucket;
#   bật Block Public Access; CORS giống R2 ở trên.
# S3_ENDPOINT="https://s3.<region>.amazonaws.com"
# S3_REGION="<region, vd ap-southeast-1>"
# S3_ACCESS_KEY_ID="<access key id>"
# S3_SECRET_ACCESS_KEY="<secret access key>"
# S3_BUCKET="learnenglish"

# ============================================================================
# 4. TẠO SUPERADMIN ĐẦU TIÊN
# ============================================================================
# Chỉ dùng 1 lần khi chạy `npm run db:seed`. Seed xong có thể xóa; đổi mật khẩu sau khi đăng nhập.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""

# ============================================================================
# 5. KIỂM TRA E2E (tùy chọn, chỉ local)
# ============================================================================
# Địa chỉ app mà các script scripts/e2e-*.ts gọi tới. Bỏ trống = http://localhost:3457
# E2E_BASE_URL="http://localhost:3457"
